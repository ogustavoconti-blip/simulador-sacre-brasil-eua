{
  "name": "simulador-sacre-brasil-eua",
  "private": true,
  "version": "0.1.0",
  "description": "Simulador Sacre de Eficiência Brasil–EUA: IR no Brasil, Foreign Tax Credit e cenários para residentes fiscais nos EUA com conta CNR.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "e2e": "vite build && playwright test",
    "mercado": "node scripts/atualizar-mercado.mjs",
    "qrcode": "node scripts/gerar-qrcode.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
